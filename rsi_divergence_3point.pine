//@version=6
indicator("RSI Divergence (3-Point Heuristic)", overlay=true, max_labels_count=500)

rsiLen = input.int(14, "RSI Period")
rsiOb = input.int(70, "RSI Overbought")
rsiOs = input.int(30, "RSI Oversold")

rsiVal = ta.rsi(close, rsiLen)

plot(rsiVal, "RSI", color=color.purple, linewidth=3)
hline(rsiOb, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(rsiOs, "Oversold", color=color.lime, linestyle=hline.style_dashed)
hline(50, "Mid", color=color.gray, linestyle=hline.style_dotted)

bullishDiv = false
bearishDiv = false
float p2 = na
float p3 = na
float r2 = na
float r3 = na

if bar_index > 20
    p2 := low[4]
    p3 := low[1]
    r2 := rsiVal[4]
    r3 := rsiVal[1]

    if not na(p3) and not na(p2) and not na(r3) and not na(r2)
        if p2 > p3 and r2 < r3
            bullishDiv := true
        if p2 < p3 and r2 > r3
            bearishDiv := true

if bullishDiv
    line.new(bar_index - 4, p2, bar_index - 1, p3,
             color=color.new(#22c55e, 80), width=3, style=line.style_solid)
    line.new(bar_index - 4, r2, bar_index - 1, r3,
             color=color.new(#22c55e, 80), width=3, style=line.style_solid)
    label.new(bar_index - 1, p3, "Bull Div",
              style=label.style_label_up, color=color.new(#22c55e, 70),
              textcolor=color.white, size=size.small)

if bearishDiv
    line.new(bar_index - 4, p2, bar_index - 1, p3,
             color=color.new(#ef4444, 80), width=3, style=line.style_solid)
    line.new(bar_index - 4, r2, bar_index - 1, r3,
             color=color.new(#ef4444, 80), width=3, style=line.style_solid)
    label.new(bar_index - 1, p3, "Bear Div",
              style=label.style_label_down, color=color.new(#ef4444, 70),
              textcolor=color.white, size=size.small)

alertcondition(bullishDiv, title="Bullish Divergence",
               message="Bullish RSI Divergence on {{ticker}} at {{close}}")
alertcondition(bearishDiv, title="Bearish Divergence",
               message="Bearish RSI Divergence on {{ticker}} at {{close}}")
