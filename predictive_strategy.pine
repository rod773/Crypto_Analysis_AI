//@version=6
indicator("Predictive Strategy", overlay=true, max_labels_count=500)

// ── Parameters ──
rsiLen = input.int(14, "RSI Period")
macdFast = input.int(12, "MACD Fast")
macdSlow = input.int(26, "MACD Slow")
macdSig = input.int(9, "MACD Signal")
maLen = input.int(50, "MA Period")
volLen = input.int(20, "Volume Lookback")
volMult = input.float(1.5, "Volume Multiplier")
minScore = input.int(3, "Min Score for Entry")
slLongPct = input.float(6.0, "Stop Loss Long %")
tpLongPct = input.float(12.0, "Take Profit Long %")
slShortPct = input.float(6.0, "Stop Loss Short %")
tpShortPct = input.float(10.0, "Take Profit Short %")

// ── Indicators ──
rsiVal = ta.rsi(close, rsiLen)
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSig)
ma50 = ta.sma(close, maLen)
avgVol = ta.sma(volume, volLen)
volSpike = volume > avgVol * volMult

// ── Divergence Detection ──
var int lastDivIdx = 0
var float lastDivLow = 0.0
var float lastDivRsi = 0.0
var int prevDivIdx = 0
var float prevDivLow = 0.0
var float prevDivRsi = 0.0

bullishDiv = false
bearishDiv = false

// Sample every 3 bars over the last ~10 bars
if bar_index > 20
    // Find the last 2 sample points (step=3, range idx-10 to idx)
    sampleIdx1 = bar_index - 10
    sampleIdx2 = bar_index - 7
    sampleIdx3 = bar_index - 4
    sampleIdx4 = bar_index - 1

    // Get low at each sample point
    low1 = ta.valuewhen(bar_index == sampleIdx1, low, 0)
    low2 = ta.valuewhen(bar_index == sampleIdx2, low, 0)
    low3 = ta.valuewhen(bar_index == sampleIdx3, low, 0)
    low4 = ta.valuewhen(bar_index == sampleIdx4, low, 0)
    rsi1 = ta.valuewhen(bar_index == sampleIdx1, rsiVal, 0)
    rsi2 = ta.valuewhen(bar_index == sampleIdx2, rsiVal, 0)
    rsi3 = ta.valuewhen(bar_index == sampleIdx3, rsiVal, 0)
    rsi4 = ta.valuewhen(bar_index == sampleIdx4, rsiVal, 0)

    // Use last 2 sample points for comparison
    if na(low4) == false and na(low3) == false and na(rsi4) == false and na(rsi3) == false
        if low3 > low4 and rsi3 < rsi4
            bullishDiv := true
        if low3 < low4 and rsi3 > rsi4
            bearishDiv := true

// ── MACD Signals ──
histGrowing = histLine > histLine[2]
histDeclining = histLine < histLine[2]
macdBuy = histGrowing and macdLine < signalLine
macdSell = histDeclining and macdLine > signalLine

// ── Scoring ──
buyScore = 0
sellScore = 0

if bullishDiv
    buyScore := buyScore + 3
if macdBuy
    buyScore := buyScore + 2
if close > ma50
    buyScore := buyScore + 1
if rsiVal < 35
    buyScore := buyScore + 1
if volSpike
    buyScore := buyScore + 1

if bearishDiv
    sellScore := sellScore + 3
if macdSell
    sellScore := sellScore + 2
if close < ma50
    sellScore := sellScore + 1
if rsiVal > 65
    sellScore := sellScore + 1
if volSpike
    sellScore := sellScore + 1

// ── Signals ──
var int lastSignalBar = 0
signalDir = ""
signalReason = ""
slPrice = 0.0
tpPrice = 0.0

if buyScore > sellScore and buyScore >= minScore
    if lastSignalBar != bar_index
        signalDir := "buy"
        signalReason := bullishDiv ? "Divergence" : "MACD"
        slPrice := close * (1 - slLongPct / 100)
        tpPrice := close * (1 + tpLongPct / 100)
        lastSignalBar := bar_index

if sellScore > buyScore and sellScore >= minScore
    if lastSignalBar != bar_index
        signalDir := "sell"
        signalReason := bearishDiv ? "Divergence" : "MACD"
        slPrice := close * (1 + slShortPct / 100)
        tpPrice := close * (1 - tpShortPct / 100)
        lastSignalBar := bar_index

// ── Plotting ──
plotshape(signalDir == "buy", style=shape.triangleup, location=location.belowbar,
          color=color.new(#22c55e, 0), size=size.small, text="B")
plotshape(signalDir == "sell", style=shape.triangledown, location=location.abovebar,
          color=color.new(#ef4444, 0), size=size.small, text="S")

// SL/TP lines (only on signal bar)
if signalDir == "buy"
    line.new(bar_index, slPrice, bar_index, slPrice, xloc.bar_index, extend.right,
             color=color.new(#ef4444, 60), width=1, style=line.style_dashed)
    line.new(bar_index, tpPrice, bar_index, tpPrice, xloc.bar_index, extend.right,
             color=color.new(#22c55e, 60), width=1, style=line.style_dashed)

if signalDir == "sell"
    line.new(bar_index, slPrice, bar_index, slPrice, xloc.bar_index, extend.right,
             color=color.new(#ef4444, 60), width=1, style=line.style_dashed)
    line.new(bar_index, tpPrice, bar_index, tpPrice, xloc.bar_index, extend.right,
             color=color.new(#22c55e, 60), width=1, style=line.style_dashed)

// Score panel
var table scoreTable = table.new(position.top_right, 2, 2,
                                 bgcolor=color.new(#131722, 90),
                                 border_color=color.new(#636d7d, 60))
if bar_index == last_bar_index - 1
    table.cell(scoreTable, 0, 0, "Buy Score", text_color=color.white, text_size=size.small)
    table.cell(scoreTable, 1, 0, str.tostring(buyScore), text_color=color.lime, text_size=size.small)
    table.cell(scoreTable, 0, 1, "Sell Score", text_color=color.white, text_size=size.small)
    table.cell(scoreTable, 1, 1, str.tostring(sellScore), text_color=color.red, text_size=size.small)

// ── Alerts ──
alertcondition(signalDir == "buy", title="Buy Signal", message="Buy signal: {{ticker}} at {{close}}")
alertcondition(signalDir == "sell", title="Sell Signal", message="Sell signal: {{ticker}} at {{close}}")
